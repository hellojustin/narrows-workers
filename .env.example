# AWS Configuration
AWS_REGION=us-east-1

# VPC Configuration (for Lambda functions to access internal services)
# Required for accessing Graphiti within the VPC
VPC_SUBNET_IDS=subnet-xxx,subnet-yyy
VPC_SECURITY_GROUP_IDS=sg-xxx

# S3 Bucket for media storage
MEDIA_BUCKET_NAME=your-media-bucket-name

# The Lambda functions never connect to Postgres directly: all their reads and
# writes go through the Narrows API below. DATABASE_URL is only for backfill
# scripts that need a selection the API cannot express, and they use it read-only.
# See scripts/backfill-waveform-analysis.ts.
DATABASE_URL=postgres://user:password@host:5432/narrows

# Graphiti API
GRAPHITI_API_URL=http://your-graphiti-host:8000
GRAPHITI_API_KEY=your-graphiti-api-key
# Single graph ID for all podcast ingestion (all series go to one graph)
GRAPHITI_GRAPH_ID=your-graph-id

# OpenAI for contextual chunk generation
OPENAI_API_KEY=sk-your-openai-api-key

# AWS MediaConvert
MEDIACONVERT_ENDPOINT=https://your-mediaconvert-endpoint.mediaconvert.us-east-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789:role/MediaConvertRole

# AssemblyAI (for speech-to-text transcription)
# Get your API key from https://www.assemblyai.com/dashboard
# Note: ASSEMBLYAI_WEBHOOK_URL is NOT set here — it is auto-wired by SST at deploy time
# via onTranscriptionWebhook.url (the Function URL of the webhook Lambda)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Narrows API (for updating episode records)
NARROWS_API_URL=http://your-narrows-api-host
NARROWS_API_KEY=your-narrows-api-key

# PodcastIndex API (for RSS feed lookup in discovery pipeline)
# Register at https://podcastindex.org/developer
PODCASTINDEX_API_KEY=your-podcastindex-api-key
PODCASTINDEX_API_SECRET=your-podcastindex-api-secret

# Listening Events Queue (output by SST deploy, set in narrows ECS config)
# LISTENING_EVENTS_QUEUE_URL is auto-managed by SST via the ListeningEventsQueue construct

# SQS Queue for subtitle generation
SUBTITLE_GENERATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/897768183373/narrows-production-subtitle-generation

# SQS Queue for waveform analysis, used by the waveform backfill script
AUDIO_ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/897768183373/narrows-production-audio-analysis

# Transcoder rollout (see packages/functions/src/shared/transcoder-routing.ts).
# Unset means MediaConvert, which is the pre-ffmpeg behaviour.
#   TRANSCODER=ffmpeg                    route every episode to the ffmpeg Lambda
#   FFMPEG_TRANSCODE_SERIES_IDS=id,id    always route these series to ffmpeg
#   FFMPEG_TRANSCODE_PERCENT=10          route this share of series to ffmpeg
TRANSCODER=
FFMPEG_TRANSCODE_SERIES_IDS=
FFMPEG_TRANSCODE_PERCENT=
