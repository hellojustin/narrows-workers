{
  "name": "narrows-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.dev -- sst dev --stage dev",
    "deploy:dev": "npm test && dotenv -e .env.dev -- sst deploy --stage dev",
    "deploy:staging": "npm test && dotenv -e .env.staging -- sst deploy --stage staging",
    "deploy:production": "npm test && dotenv -e .env.production -- sst deploy --stage production",
    "remove:dev": "dotenv -e .env.dev -- sst remove --stage dev",
    "remove:staging": "dotenv -e .env.staging -- sst remove --stage staging",
    "remove:production": "dotenv -e .env.production -- sst remove --stage production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:prompt": "NODE_OPTIONS='--disable-warning=DEP0040' dotenv --no-expand -e .env.production -- tsx scripts/test-discovery-prompt.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^20.11.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv-cli": "^11.0.0",
    "sst": "^3.3.27",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  }
}
